{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codemap-config/1",
  "title": "codemap.config.json: your settings, notes and overrides (Spec 1 §6, Spec 2 §7.4)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "project": { "type": "string", "description": "Display name override" },
    "ignore": { "type": "array", "items": { "type": "string" }, "description": "Extra globs to skip" },
    "entrypoints": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "requestWrappers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "description": "Function name, e.g. call" },
          "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "WS"], "description": "Default method when the call does not say" }
        }
      }
    },
    "hubFanIn": { "type": "integer", "minimum": 1, "default": 10 },
    "featureDistance": { "type": "integer", "minimum": 0, "maximum": 10, "default": 2 },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "full": { "type": "array", "items": { "type": "string" }, "description": "Globs where every symbol is emitted" }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^feature:" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "seeds": { "type": "array", "items": { "type": "string" }, "description": "Node ids or path globs" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "include": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "exclude": { "type": "array", "items": { "$ref": "#/$defs/id" } },
          "roles": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/id" },
            "additionalProperties": { "enum": ["entry", "core", "support", "shared"] }
          }
        }
      }
    },
    "notes": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "type": "string", "maxLength": 2000 }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "additionalProperties": false,
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["imports", "renders", "calls", "uses", "reads", "writes", "requests", "routes", "extends", "tests", "spawns", "configures", "changes-with"] },
          "note": { "type": "string" }
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "description": "Git history step (Spec 1 §4.7.1)",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "maxCommits": { "type": "integer", "minimum": 1, "default": 100 },
        "bulkFiles": { "type": "integer", "minimum": 1, "default": 50, "description": "Commits with more mapped files are not used for co-change or grouping" },
        "coChangeMin": { "type": "integer", "minimum": 1, "default": 3 },
        "refPatterns": { "type": "array", "items": { "type": "string" }, "description": "Regexes matched in commit subjects; each match groups commits into feature:ref-<slug>. Default: issue #123 and tracker keys ABC-45" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": { "enum": ["ui", "state", "routing", "data-fetching", "http-server", "auth", "database", "storage", "ipc", "i18n", "testing", "build", "styling", "validation", "logging", "media", "ml", "other"] }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^(project|pkg|dir|file|sym|route|endpoint|command|ext|feature):" }
  }
}
